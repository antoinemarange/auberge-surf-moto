---
// Pictos au trait, couleur = currentColor
interface Props {
  nom: 'vague' | 'moto' | 'maison' | 'crew' | 'drapeau' | 'etiquette' | 'planche' | 'van';
  taille?: number;
}

const { nom, taille = 40 } = Astro.props;
---

<svg
  class="picto"
  width={taille}
  height={taille}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {nom === 'vague' && (
    <>
      <path d="M3 22c2.5 0 3.5-2 6-2s3.5 2 6 2 3.5-2 6-2 3.5 2 6 2" />
      <path d="M3 27c2.5 0 3.5-2 6-2s3.5 2 6 2 3.5-2 6-2 3.5 2 6 2" />
      <path d="M7 17c0-6 5-11 11-11 4 0 7 3 7 6.5 0 2.5-2 4.5-4.5 4.5-2 0-3.5-1.5-3.5-3.3" />
    </>
  )}
  {nom === 'moto' && (
    <>
      <circle cx="7" cy="21" r="4.5" />
      <circle cx="25" cy="21" r="4.5" />
      <path d="M7 21l5.5-8h7l5.5 8" />
      <path d="M12.5 13l-2-3.5H7" />
      <path d="M19.5 13l2.5-5h3" />
      <path d="M14 17h4" />
    </>
  )}
  {nom === 'maison' && (
    <>
      <path d="M4 28V11h24v17" />
      <path d="M2 28h28" />
      <path d="M4 11l2-3h20l2 3" />
      <path d="M13 28v-6a3 3 0 0 1 6 0v6" />
      <path d="M8 15h3v3H8zM21 15h3v3h-3z" />
    </>
  )}
  {nom === 'crew' && (
    <>
      <circle cx="9" cy="11" r="3" />
      <circle cx="16" cy="9" r="3.4" />
      <circle cx="23" cy="11" r="3" />
      <path d="M3.5 25c0-4 2.5-7 5.5-7 1.5 0 2.7.6 3.6 1.6" />
      <path d="M28.5 25c0-4-2.5-7-5.5-7-1.5 0-2.7.6-3.6 1.6" />
      <path d="M9.5 27c0-5 3-8.5 6.5-8.5s6.5 3.5 6.5 8.5" />
    </>
  )}
  {nom === 'drapeau' && (
    <>
      <path d="M8 29V4" />
      <path d="M8 5h16l-4.5 5.5L24 16H8" />
    </>
  )}
  {nom === 'etiquette' && (
    <>
      <path d="M4 16V5h11l13 13-11 11z" />
      <circle cx="9.5" cy="10.5" r="2" />
    </>
  )}
  {nom === 'planche' && (
    <>
      <ellipse cx="16" cy="16" rx="5" ry="13.5" transform="rotate(35 16 16)" />
      <path d="M9.7 25 22.3 7" />
    </>
  )}
  {nom === 'van' && (
    <>
      <path d="M6.5 23H3v-9a5 5 0 0 1 5-5h13l7 6.5V23h-2.5M11.5 23h9" />
      <circle cx="9" cy="23" r="2.5" />
      <circle cx="23" cy="23" r="2.5" />
      <path d="M8 13h5v3.5H8zM16 13h4.5l3.5 3.5h-8z" />
    </>
  )}
</svg>
