---
// Pied de page commun : infos pratiques, avis, mot géant.
import { EMAIL, INSTAGRAM_MOTO_URL, INSTAGRAM_SURF_URL, MAPS_URL, NAV, WHATSAPP_NUMERO, WHATSAPP_URL } from '../data/contact';

// Avis Google Maps réels, extraits courts (relevés sur la fiche le 2026-10-08, 5,0 ★ / 179 avis).
const AVIS_GOOGLE: { texte: string; auteur: string; quand: string }[] = [
  { texte: 'Un endroit chaleureux, confortable et aussi accueillant que ses propriétaires.', auteur: 'Hélène D.', quand: 'il y a 9 mois' },
  { texte: 'Des personnes incroyables. Je ne peux que recommander cette expérience !', auteur: 'Manon L.', quand: 'il y a un an' },
  { texte: 'On se sent comme à la maison. Younès et Margot sont adorables.', auteur: 'Marie-Lucie L.', quand: 'il y a 3 ans' },
];
---

<footer class="pied" id="infos">
  <div class="wrap grille">
    <div class="infos">
      <h2 class="display">Infos</h2>
      <dl>
        <div><dt>WhatsApp</dt><dd><a href={WHATSAPP_URL}>{WHATSAPP_NUMERO}</a></dd></div>
          <div><dt>E-mail</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd></div>
        <div><dt>Adresse</dt><dd><a href={MAPS_URL} target="_blank" rel="noopener">Good Wave Surf House</a>, 80023 Tamraght Oufella, Maroc</dd></div>
        <div>
          <dt>Instagram</dt>
          <dd><a href={INSTAGRAM_SURF_URL} target="_blank" rel="noopener">Auberge + Surf</a> · <a href={INSTAGRAM_MOTO_URL} target="_blank" rel="noopener">Moto</a></dd>
        </div>
        <div><dt>Langues</dt><dd>Français, English, Español, العربية</dd></div>
      </dl>
      <nav aria-label="Pied de page">
        {NAV.filter(([href]) => href.startsWith('/')).map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </div>

    <div class="cote">
      <p class="avis accroche">5,0 sur Google, 179 avis.<br />9,5 sur Booking, 90 avis.</p>

      <!-- Avis Google Maps : un à la fois, en fondu, en boucle (CSS seul) -->
      <section class="google" aria-label="Avis Google Maps">
        <p class="google__tete">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 10.2H12v3.9h5.5c-.5 2.5-2.7 4.1-5.5 4.1a6.2 6.2 0 1 1 4-10.9l2.9-2.8A10.2 10.2 0 1 0 22.2 12c0-.6-.2-1.3-.6-1.8Z"/></svg>
          avis google maps
        </p>
        <div class="google__pile">
          {AVIS_GOOGLE.map((a, i) => (
            <figure style={`--i: ${i}`}>
              <span class="etoiles" role="img" aria-label="5 étoiles sur 5">★★★★★</span>
              <blockquote>« {a.texte} »</blockquote>
              <figcaption>{a.auteur} · {a.quand}</figcaption>
            </figure>
          ))}
        </div>
        <a class="bouton" href={MAPS_URL} target="_blank" rel="noopener">lire les 179 avis <span class="fleche" aria-hidden="true">→</span></a>
      </section>
    </div>
  </div>

  <p class="geant display" aria-hidden="true">Good Wave Surf House</p>
</footer>

<style>
  .pied {
    background: var(--encre);
    color: var(--chaux);
    padding-top: 48px;
    overflow: hidden;
  }
  .grille { display: grid; gap: 32px; }
  h2 { font-size: clamp(2rem, 6vw, 3rem); margin-bottom: 16px; }
  dl { margin: 0; }
  dl > div {
    display: grid;
    grid-template-columns: 11ch 1fr;
    gap: 12px;
    padding-block: 8px;
    border-top: 1px solid var(--filet);
    font-family: var(--font-mono);
    font-size: .8125rem;
  }
  dt { opacity: .6; }
  dd { margin: 0; overflow-wrap: anywhere; }

  /* Le menu descend au pied de la colonne gauche pour finir à la hauteur des avis. */
  .infos { display: flex; flex-direction: column; }
  .cote { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .avis {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 85;
    line-height: 1.15;
    max-width: 24ch;
  }

  /* Carte d'avis Google : filet fin comme les fiches, mono, avis qui défilent en fondu. */
  .google {
    display: grid;
    gap: 10px;
    width: 100%;
    padding: 14px 16px 16px;
    border: 1.5px solid var(--filet);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: .8125rem;
  }
  .google__tete { display: flex; align-items: center; gap: 8px; margin: 0; opacity: .7; }
  .google__tete svg { width: 16px; height: 16px; }
  .google__pile { display: grid; }
  .google__pile figure {
    grid-area: 1 / 1;
    margin: 0;
    display: grid;
    gap: 8px;
    align-content: start;
    animation: avis 15s infinite both;
    animation-delay: calc(var(--i) * 5s);
  }
  .google:hover figure { animation-play-state: paused; }
  .etoiles { letter-spacing: .15em; }
  blockquote { margin: 0; line-height: 1.55; }
  figcaption { opacity: .6; font-size: .8125rem; }
  @keyframes avis {
    0% { opacity: 0; transform: translateY(8px); }
    3%, 30% { opacity: 1; transform: none; }
    33.3%, 100% { opacity: 0; transform: translateY(-8px); }
  }
  .bouton {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1.5px solid var(--filet);
    border-radius: var(--radius);
    color: var(--chaux);
    text-decoration: none;
    transition: border-color .25s ease;
  }
  .bouton .fleche { transition: transform .25s ease; }
  .bouton:hover, .bouton:focus-visible { border-color: currentColor; }
  .bouton:hover .fleche, .bouton:focus-visible .fleche { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) {
    .google__pile figure { animation: none; }
    .google__pile figure + figure { display: none; }
  }
  /* Les pages, en ligne sous les langues. */
  .pied nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: auto;
    padding-top: 24px;
    font-family: var(--font-mono);
    font-size: .875rem;
  }

  .geant {
    margin: 40px 0 0;
    font-size: 11vw;
    line-height: .74;
    white-space: nowrap;
    text-align: center;
    margin-bottom: -.06em;
    opacity: .96;
  }

  @media (min-width: 820px) {
    .pied { padding-top: 64px; }
    .grille { grid-template-columns: 7fr 5fr; gap: 64px; }
    .cote { padding-top: 4px; }
  }
</style>
