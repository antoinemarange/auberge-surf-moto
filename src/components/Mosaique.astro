---
// Mosaïque photo arrondie : grandes tuiles 2×2 et tuiles larges en rythme, le reste en petites.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;
---

<div class="mosaique">
  {photos.map((p, i) => (
    <figure class="tuile">
      <Image
        src={p.src}
        alt={p.alt}
        width={Math.min(1200, p.src.width)}
        widths={[480, 800, 1200].filter((w) => w <= p.src.width)}
        sizes="(min-width: 900px) 50vw, 100vw"
        loading={i < 3 ? 'eager' : 'lazy'}
      />
    </figure>
  ))}
</div>

<style>
  .mosaique {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 120px;
    grid-auto-flow: dense;
  }
  .tuile {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--piste) 30%, transparent);
  }
  .tuile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Mobile, 2 colonnes : une grande tuile puis 4 petites, en boucle */
  .tuile:nth-child(5n + 1) { grid-column: span 2; grid-row: span 2; }

  /* Ordi, 4 colonnes : blocs de 8 tuiles sur 3 rangées, grande tuile à gauche puis à droite */
  @media (min-width: 820px) {
    .mosaique {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 170px;
      gap: 10px;
    }
    .tuile:nth-child(5n + 1) { grid-column: auto; grid-row: auto; }
    .tuile:nth-child(8n + 1) { grid-column: 1 / span 2; grid-row: span 2; }
    .tuile:nth-child(16n + 9) { grid-column: 3 / span 2; }
    .tuile:nth-child(8n + 4) { grid-column: span 2; }
    /* 26 photos : la dernière comble le bloc incomplet */
    .tuile:last-child:nth-child(16n + 10) { grid-column: 1 / span 2; grid-row: span 2; }
  }
  @media (min-width: 1100px) {
    .mosaique { grid-auto-rows: 200px; }
  }
</style>
