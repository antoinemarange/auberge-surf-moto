---
// Photo arrondie + grain. Sans `src`, affiche un placeholder [PHOTO : …].
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  legende?: string;
  ton?: 'mer' | 'piste' | 'chaux';
  ratio?: string;
  position?: string;
  sizes?: string;
}

const {
  src,
  alt = '',
  legende = 'à venir',
  ton = 'chaux',
  ratio = '4 / 5',
  position = 'center',
  sizes = '(min-width: 900px) 50vw, 100vw',
} = Astro.props;
const largeurs = [480, 800, 1200, 1600, 2000];
---

<figure class:list={['photo', `photo--${ton}`]} style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <Image
      src={src}
      alt={alt}
      width={Math.min(2000, src.width)}
      widths={largeurs.filter((w) => w <= src.width)}
      sizes={sizes}
      loading="lazy"
      style={`object-position: ${position}`}
    />
  ) : (
    <figcaption>[PHOTO : {legende}]</figcaption>
  )}
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    display: flex;
    align-items: flex-end;
    padding: 16px;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    font-family: var(--font-mono);
    font-size: .75rem;
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
  .photo--mer { background: linear-gradient(170deg, #3a3a3a, #0a0a0a); color: var(--chaux); }
  .photo--piste { background: linear-gradient(170deg, #e3d6c1, #8a6f52); color: var(--encre); }
  .photo--chaux { background: linear-gradient(170deg, #f5efe4, #cdbfa8); color: var(--argan); }
</style>
