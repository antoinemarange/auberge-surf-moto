---
// Bas de page : une phrase + le bouton WhatsApp.
// Avec `photos` (des rangées de photos), la moitié des rangées passe au-dessus du texte, le reste en dessous.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BoutonWhatsApp from './BoutonWhatsApp.astro';

type Rangee = { src: ImageMetadata; alt: string }[];

interface Props {
  titre: string;
  label?: string;
  photos?: Rangee[];
  /** Sans filet au-dessus, marges resserrées */
  compact?: boolean;
}

const { titre, label, photos = [], compact = false } = Astro.props;
const moitie = Math.ceil(photos.length / 2);
const dessus = photos.slice(0, moitie);
const dessous = photos.slice(moitie);
---

{dessus.length > 0 && (
  <div class="wrap bandes bandes--dessus">
    {dessus.map((r) => (
      <div class="bande">
        {r.map((p) => <Image src={p.src} alt={p.alt} widths={[480, 800]} sizes="(min-width: 820px) 33vw, 50vw" loading="lazy" />)}
      </div>
    ))}
  </div>
)}

<section class:list={['bloc appel', { 'appel--photos': photos.length > 0, 'appel--compact': compact }]}>
  <div class="wrap">
    <h2 class="display">{titre}</h2>
    <BoutonWhatsApp label={label} />
  </div>
</section>

{dessous.length > 0 && (
  <div class="wrap bandes bandes--dessous">
    {dessous.map((r) => (
      <div class="bande">
        {r.map((p) => <Image src={p.src} alt={p.alt} widths={[480, 800]} sizes="(min-width: 820px) 33vw, 50vw" loading="lazy" />)}
      </div>
    ))}
  </div>
)}

<style>
  .appel { border-top: 1px solid var(--filet); }
  .appel--photos { border-top: 0; padding-block: 56px; }
  .appel--compact { border-top: 0; padding-block: 48px 96px; }

  /* Rangées de photos : quatre par rangée, largeurs qui alternent d'une rangée à l'autre. */
  .bandes { display: grid; gap: 8px; }
  .bandes--dessus { padding-top: 64px; }
  .bandes--dessous { padding-bottom: 64px; }
  /* Rangée bloquée à sa hauteur : sinon une photo verticale l'étire et la fait déborder. */
  .bande { display: grid; gap: 8px; height: 96px; grid-template-rows: 100%; grid-template-columns: 1.6fr 1fr 1.3fr 1fr; }
  .bande:nth-child(3n + 2) { grid-template-columns: 1fr 1.5fr 1fr 1.4fr; }
  .bande:nth-child(3n + 3) { grid-template-columns: 1.3fr 1fr 1.7fr 1fr; }
  .bande :global(img) {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .appel .wrap { display: grid; gap: 24px; justify-items: start; }
  h2 { margin-bottom: 0; max-width: 12ch; }
  @media (min-width: 820px) {
    .appel .wrap { grid-template-columns: 1fr auto; align-items: end; }
    .bandes, .bande { gap: 10px; }
    .bande { height: 180px; }
    .bandes--dessus { padding-top: 96px; }
    .bandes--dessous { padding-bottom: 96px; }
  }
</style>
