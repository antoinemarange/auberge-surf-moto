---
// Accueil : bloc auberge avec carrousel photo 16:9, renvoie vers /auberge
import Carrousel from './Carrousel.astro';
import { photosAuberge } from '../data/photos-auberge';

// Une ligne par élément, sans virgule
const specs: [string, string[]][] = [
  ['chambres', ['Doubles', 'Triples', 'Dortoirs 4 lits']],
  ['vue', ['Plusieurs chambres face à l\'océan', 'Vue sur les spots']],
  ['repas', ['Petit-déj partagé', 'Dîners certains soirs']],
  ['partagé', ['Salons', 'Espace yoga', 'Rooftop']],
  ['surf', ['Les meilleurs spots aux alentours']],
  ['avis', ['5/5 sur Google', '9,5 sur Booking']],
];
---

<section class="bloc auberge" id="auberge">
  <div class="wrap">
    <div class="grille">
      <Carrousel
        photos={photosAuberge.slice(0, 14)}
        label="Photos de l'auberge"
        sizes="(min-width: 1100px) 60vw, 100vw"
      >
        <h2 slot="encoche" class="display encoche">L’auberge</h2>
        <a slot="action" class="lien" href="/auberge">Voir l'auberge →</a>
      </Carrousel>
      <div class="texte">
        <p>Une maison marocaine sur les hauteurs de Tamraght. Un rooftop face à la baie de Taghazout, le petit-déj tous ensemble et, certains soirs, le dîner aussi.</p>
        <dl>
          {specs.map(([cle, valeur]) => (
            <div><dt>{cle}</dt>{valeur.map((ligne) => <dd>{ligne}</dd>)}</div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* Les flèches (48px) ont du vide sous leur picto : on retire ces ~14px et les 8px de marge
     du bloc Spots qui suit, pour que l'écart sous la section égale celui du dessus. */
  .auberge { padding-bottom: 50px; }
  @media (min-width: 820px) { .auberge { padding-bottom: 74px; } }
  .grille { display: grid; gap: 32px; }
  .texte { display: flex; flex-direction: column; gap: 32px; }
  p { margin: 0; max-width: 46ch; }

  /* Infos en petite grille : l'étiquette grisée au-dessus, la valeur dessous. */
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
    font-size: .875rem;
    line-height: 1.4;
  }
  dt { font-size: .75rem; opacity: .55; margin-bottom: 4px; }
  dd { margin: 0; }

  /* Côte à côte : la photo prend la place, le texte tient dans une colonne étroite,
     paragraphe en haut, infos calées sur le bas de la photo. Marges de la colonne du site,
     les mêmes à gauche et à droite que les autres sections. */
  @media (min-width: 1100px) {
    /* Un peu plus large que la colonne du site (1200px) : marges un peu réduites, place pour le texte à droite */
    .wrap { max-width: 1360px; }
    .grille { grid-template-columns: minmax(0, 1fr) 360px; gap: 48px; }
    /* Les infos suivent directement le paragraphe, en haut de la colonne.
       Le carrousel s'efface de la grille (display: contents) : la photo reste à gauche sur deux rangées,
       flèches et « Voir l'auberge » passent dans la colonne de droite, sous les infos. */
    .grille { grid-template-rows: auto 1fr; }
    .auberge :global(.carrousel) { display: contents; }
    .auberge :global(.carrousel .cadre) { grid-column: 1; grid-row: 1 / span 2; }
    .texte { grid-column: 2; grid-row: 1; }
    .auberge :global(.carrousel .commandes) { grid-column: 2; grid-row: 2; align-self: end; margin-bottom: -14px; justify-content: space-between; margin-left: -14px; }
  }
</style>
