---
// Accueil : bloc « venez en crew », renvoie vers /crews.
// À droite, un reel Instagram en boucle (muet, en 3:4) qui ouvre le post.
import { WHATSAPP_URL } from '../data/contact';

const REEL_URL = 'https://www.instagram.com/reel/DeE2-HUMqdI/';
const REEL_VIDEO = '/video/crew-reel.mp4';
const REEL_POSTER = '/video/crew-reel.jpg';

// Infos en lignes, dans la DA des fiches : carré, étiquette grisée, valeur
const lignes: [string, string][] = [
  ['pour', 'Club, team building, voyage de groupe, bande de potes'],
  ['on gère', 'Le séjour, de la sortie de l’aéroport jusqu’à votre dernier tajine'],
  ['inclus', 'Package surf et/ou hébergement, et activités à la carte'],
];
---

<section class="crews" aria-labelledby="crews-titre">
  <div class="wrap">
    <div class="carte grille">
      <div class="texte">
        <h2 class="display" id="crews-titre">Venez en crew</h2>
        <dl>
          {lignes.map(([cle, valeur]) => (
            <div><dt>{cle}</dt><dd>{valeur.startsWith('[À COMPLÉTER') ? <span class="todo">{valeur}</span> : valeur}</dd></div>
          ))}
        </dl>
        <div class="actions">
          <a class="bouton" href={WHATSAPP_URL}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.1 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z"/></svg>
            organiser un séjour crew
          </a>
          <a class="bouton" href="/crews">comment ça se passe <span class="fleche" aria-hidden="true">→</span></a>
        </div>
      </div>
      <a class="reel" href={REEL_URL} target="_blank" rel="noopener" aria-label="Voir la vidéo sur Instagram (nouvel onglet)">
        <video src={REEL_VIDEO} poster={REEL_POSTER} autoplay muted loop playsinline preload="metadata"></video>
        <span class="reel__haut" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".9" fill="currentColor" stroke="none" /></svg>
          seayoubarcelona
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Effet carte : la carte noire tient dans la colonne du site, sur le fond beige.
     La vidéo s'y pose à 8px du bord, le même liseré que la marge beige des cartes bord à bord. */
  .crews { padding-block: 64px 0; }
  .carte {
    --liseret: 8px;
    border-radius: var(--radius);
    background: var(--encre);
    color: var(--chaux);
    padding: var(--liseret);
  }
  .grille { display: grid; gap: 32px; align-items: center; }
  .texte { display: grid; gap: 18px; justify-items: start; padding: 24px 16px 16px; }
  h2 { font-size: clamp(2.75rem, 11vw, 5.5rem); } /* même taille que les titres des autres sections */
  dl { margin: 0; width: 100%; max-width: 520px; }
  dl > div {
    display: grid;
    grid-template-columns: 11ch 1fr;
    gap: 12px;
    padding-block: 8px;
    font-family: var(--font-mono);
    font-size: .875rem;
    line-height: 1.45;
  }
  dt::before {
    content: '';
    display: inline-block;
    width: .45em;
    height: .45em;
    margin-right: .5em;
    vertical-align: .12em;
    background: currentColor;
  }
  dt { opacity: .6; }
  dd { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
  /* Boutons dans la DA des fiches : filet fin, coins arrondis, mono, pas de fond. */
  .bouton {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1.5px solid var(--filet);
    border-radius: var(--radius);
    color: var(--chaux);
    font-family: var(--font-mono);
    font-size: .875rem;
    text-decoration: none;
    transition: border-color .25s ease;
  }
  .bouton svg { width: 16px; height: 16px; flex: none; }
  .bouton .fleche { transition: transform .25s ease; }
  .bouton:hover, .bouton:focus-visible { border-color: currentColor; }
  .bouton:hover .fleche, .bouton:focus-visible .fleche { transform: translateX(4px); }
  .bouton:focus-visible { outline: 2px solid var(--chaux); outline-offset: 3px; }

  /* Reel : la vidéo seule en 3:4, sans cadre, le nom du compte discret en haut. Toute la vidéo est le lien. */
  .reel {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: calc(var(--radius) - var(--liseret)); /* arrondi concentrique à celui de la carte */
    background: #000;
    color: #fff;
    text-decoration: none;
    overflow: hidden;
  }
  .reel video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel__haut {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: .75rem;
    opacity: .85;
  }
  .reel__haut svg { width: 16px; height: 16px; }
  .reel:focus-visible { outline: 2px solid var(--chaux); outline-offset: 3px; }

  @media (min-width: 820px) {
    .crews { padding-top: 96px; }
    .grille { grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 48px; align-items: stretch; }
    .texte { padding: clamp(32px, 4vw, 56px) 0 clamp(32px, 4vw, 56px) clamp(32px, 4vw, 56px); }
    /* Le haut du titre s'aligne sur le haut de la vidéo, les boutons sur son bas. */
    .texte { display: flex; flex-direction: column; align-items: flex-start; }
    .texte h2 { text-box: trim-both cap alphabetic; }
    .texte .actions { margin-top: auto; }
  }
</style>
