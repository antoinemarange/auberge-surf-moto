  <!-- Nord, échelle, zoom et Mirleft : hors du dessin, ils ne bougent pas quand on zoome -->
  <div class="nord" aria-hidden="true"><svg viewBox="0 0 10 14"><path d="M0 14 L5 0 L10 14" /></svg>N</div>
  <div class="echelle" aria-hidden="true"><span class="barre"></span><span class="km">10 km</span></div>
  <p class="hors-cadre">Mirleft ↓ à 110 km</p>
  <div class="zoom">
    <button type="button" data-zoom="1" aria-label="Zoomer sur la carte">+</button>
    <button type="button" data-zoom="-1" aria-label="Dézoomer la carte" disabled>−</button>
  </div>
</figure>

<script>
  // Zoom par boutons, déplacement en glissant une fois zoomé.
  // Le viewBox se resserre ; le masque de fondu suit la vue ; les repères gardent leur taille.
  const PAS = 1.6, MAX = 4.1, KM = 5; // 5 unités = 1 km
  document.querySelectorAll<HTMLElement>('.carte').forEach((fig) => {
    const svg = fig.querySelector<SVGSVGElement>('svg');
    const fondu = svg?.querySelector('#carte-masque rect');
    if (!svg || !fondu) return;
    const [bx, by, bw, bh] = svg.getAttribute('viewBox')!.split(' ').map(Number);
    const B = { x: bx, y: by, w: bw, h: bh };
    const fixes = svg.querySelectorAll('.fixe');
    const barre = fig.querySelector<HTMLElement>('.barre')!;
    const km = fig.querySelector<HTMLElement>('.km')!;
    const [plus, moins] = fig.querySelectorAll<HTMLButtonElement>('.zoom button');
    let z = 1, cx = B.x + B.w / 2, cy = B.y + B.h / 2;

    const borne = (v: number, a: number, b: number) => Math.min(Math.max(v, a), b);
    // Pixels écran par unité de carte (la carte peut être bornée en hauteur)
    const ech = () => {
      const r = svg.getBoundingClientRect();
      return Math.min(r.width / (B.w / z), r.height / (B.h / z));
    };
    function maj() {
      const w = B.w / z, h = B.h / z;
      cx = borne(cx, B.x + w / 2, B.x + B.w - w / 2);
      cy = borne(cy, B.y + h / 2, B.y + B.h - h / 2);
      const vb = [cx - w / 2, cy - h / 2, w, h];
      svg.setAttribute('viewBox', vb.join(' '));
      ['x', 'y', 'width', 'height'].forEach((k, i) => fondu.setAttribute(k, String(vb[i])));
      fixes.forEach((g) => g.setAttribute('transform', `scale(${1 / z})`));
      fig.classList.toggle('is-zoom', z > 1);
      plus.disabled = z >= MAX;
      moins.disabled = z <= 1;
      // Échelle : une distance ronde qui tient sous ~110 px à l'écran
      const pxKm = ech() * KM;
      const d = [50, 20, 10, 5, 2, 1].find((v) => v * pxKm <= 110) ?? 1;
      barre.style.width = `${d * pxKm}px`;
      km.textContent = d >= 1 ? `${d} km` : `${d * 1000} m`;
    }
    [plus, moins].forEach((b) =>
      b.addEventListener('click', () => {
        z = borne(z * PAS ** Number(b.dataset.zoom), 1, MAX);
        if (z < 1.01) z = 1;
        maj();
      }),
    );

    // Glisser : on capture le pointeur et on bloque la sélection / le glisser-déposer natif,
    // sinon le navigateur interrompt le mouvement (surtout à l'horizontale).
    let depart: { id: number; x: number; y: number; cx: number; cy: number } | null = null;
    svg.addEventListener('pointerdown', (e) => {
      if (z <= 1 || e.button !== 0) return;
      e.preventDefault();
      svg.setPointerCapture(e.pointerId);
      depart = { id: e.pointerId, x: e.clientX, y: e.clientY, cx, cy };
    });
    svg.addEventListener('pointermove', (e) => {
      if (!depart || e.pointerId !== depart.id) return;
      const k = 1 / ech();
      cx = depart.cx - (e.clientX - depart.x) * k;
      cy = depart.cy - (e.clientY - depart.y) * k;
      maj();
    });
    const fin = () => (depart = null);
    svg.addEventListener('pointerup', fin);
    svg.addEventListener('pointercancel', fin);
    svg.addEventListener('dragstart', (e) => e.preventDefault());
    window.addEventListener('resize', maj);
    maj();
  });
</script>

<style>
  .carte { position: relative; margin: 0; max-width: 640px; container-type: inline-size; }
  .carte > svg { display: block; width: 100%; height: auto; overflow: hidden; user-select: none; -webkit-user-select: none; }
  .carte.is-zoom > svg { cursor: grab; touch-action: none; }
  .carte.is-zoom > svg:active { cursor: grabbing; }

  /* Les traits gardent leur épaisseur quand on zoome */
  .relief, .oued, .cote { vector-effect: non-scaling-stroke; }

  .relief { fill: none; stroke: currentColor; stroke-width: .6; opacity: .3; }
  .relief--fort { stroke-width: .9; opacity: .55; }
  .oued { fill: none; stroke: currentColor; stroke-width: .8; stroke-dasharray: 1.5 3; opacity: .6; }
  .cote { fill: none; stroke: currentColor; stroke-width: 1.3; }

  text { font-family: var(--font-mono); font-size: 14px; fill: currentColor; }

  .coord { font-size: 10px; letter-spacing: .04em; opacity: .5; }

  /* Repères en surimpression : nord, échelle, zoom */
  .nord, .echelle, .zoom { position: absolute; font: 10px/1 var(--font-mono); letter-spacing: .04em; }
  .nord { left: 8%; top: 32%; display: grid; justify-items: center; gap: 4px; opacity: .5; }
  .nord svg { width: 10px; height: 14px; fill: none; stroke: currentColor; }
  .echelle { left: 8%; bottom: 10%; display: grid; gap: 5px; opacity: .5; }
  .barre { height: 4px; border: 1px solid currentColor; border-top: 0; transition: width .3s ease; }
  .zoom { right: 0; bottom: 6%; display: grid; gap: 6px; }
  .zoom button {
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    border-radius: 50%;
    background: none;
    color: inherit;
    font: 400 1rem/1 var(--font-mono);
    cursor: pointer;
  }
  .zoom button:hover:not(:disabled) { border-color: currentColor; }
  .zoom button:disabled { opacity: .3; cursor: default; }
  .zoom button:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }
  .spot { cursor: pointer; outline: none; }
  .zone { fill: transparent; }
  .point { fill: currentColor; transition: r .2s ease; }
  .spot text { opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  .spot:hover .point, .spot:focus .point { r: 5.5; }
  .spot:hover text, .spot:focus text { opacity: 1; }
  .spot:focus-visible .zone { stroke: currentColor; stroke-width: 1; }

  .maison { cursor: pointer; }
  .maison circle, .maison text { transition: opacity .2s ease; }
  .maison:hover text { text-decoration: underline; }
  .maison:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .maison circle { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .maison circle + circle { fill: currentColor; }
  .maison text:not(.coord) {
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'wdth' 75;
    font-size: 16px;
    text-transform: uppercase;
  }

  /* Même taille que les noms des lieux : 14 unités de carte, rapportées aux 432 unités de large. */
  .hors-cadre { position: absolute; left: 62%; bottom: 6%; margin: 0; transform: translateX(-50%); font: 300 calc(14 / 432.3 * 100cqw)/1 var(--font-mono); opacity: .55; }

  @media (prefers-reduced-motion: reduce) {
    .point, .spot text, .barre { transition: none; }
  }
</style>
