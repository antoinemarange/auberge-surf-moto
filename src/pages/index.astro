---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Split from '../components/Split.astro';
import BlocSpots from '../components/BlocSpots.astro';
import CommentCaMarche from '../components/CommentCaMarche.astro';
import BlocFondateurs from '../components/BlocFondateurs.astro';
import Auberge from '../components/Auberge.astro';
import BlocCrews from '../components/BlocCrews.astro';
---

<Base
  title="Good Wave — Surf et moto à Tamraght"
  description="Surf, moto et une maison berbère à Tamraght, au nord d’Agadir. Cours de surf dès 40 €, surf guiding, sorties moto, chambres vue mer. Réservation sur WhatsApp."
  enteteDansHero
>
  <Hero />
  <Split />
  <Auberge />
  <BlocSpots />
  <BlocFondateurs />
  <BlocCrews />
  <CommentCaMarche />
</Base>
